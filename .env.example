# Public Supabase project values; safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin for email auth redirects and public SEO URLs (e.g. https://your-domain.com).
# Optional locally; set in deployment for canonical/social metadata, robots.txt, and sitemap.xml.
# Must be included in the Supabase Auth redirect allowlist for /auth-callback.
SITE_URL=
