# Public Supabase project values; safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin for emailed sign-in links (e.g. https://your-domain.com).
# Optional: if empty, the current request origin is used. Must be in Supabase Auth redirect allowlist.
SITE_URL=
